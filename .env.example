# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
#
# Never commit a real secret: `.env.example` documents the variables, the
# working copy holds the values.
# ---------------------------------------------------------------------------

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Shanghai

# A 32-byte random value. Generate one with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Changing this value makes every existing encrypted private note unreadable.
APP_KEY=

# --- Database --------------------------------------------------------------
# mysql is the production driver. sqlite exists so the test suite can build the
# schema without a server.
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=my_forum
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# --- Session ---------------------------------------------------------------
SESSION_LIFETIME=7200
# Set to true whenever the site is served over HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# --- Uploads ---------------------------------------------------------------
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_PIXELS=40000000

# --- Integrations ----------------------------------------------------------
# Fine-grained, read-only token. Leave empty to disable the toolbox panels
# that depend on it; the application degrades instead of failing.
GITHUB_TOKEN=
GITHUB_CACHE_TTL=3600
STEAM_CACHE_TTL=900
